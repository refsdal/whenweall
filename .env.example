# Copy to `.env` and fill in. `docker compose up` reads this file automatically.
#
# Required — the app refuses to start without these.
# ---------------------------------------------------------------------------
# The canonical origin, used for links in e-mails and OAuth callbacks. Must be absolute http(s).
APP_URL=http://localhost:3000
# Generate with: openssl rand -base64 32
AUTH_SECRET=
# Mail is required: confirmations, .ics attachments and digests are the product, and an instance
# that cannot send them appears to work while silently failing its users.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_SECURE=false
EMAIL_FROM=whenweall <no-reply@localhost>

# Optional — each integration stays off unless every value for it is set.
# ---------------------------------------------------------------------------
# Captcha on public endpoints (poll creation, voting). Strongly recommended for a public instance.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Google sign-in and calendar sync.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# SSO via an external OIDC provider. Needs all three or sign-in stays off.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
# Display name for the OIDC sign-in button.
OIDC_NAME=sso

# Deployment
# ---------------------------------------------------------------------------
APP_ENV=production
APP_PORT=3000
# Required — compose refuses to start without it. Generate with: openssl rand -base64 24
POSTGRES_PASSWORD=
POSTGRES_PORT=5433
# Escape hatch (spec §6): set to false to run `whenweall migrate` yourself instead of on boot.
MIGRATE_ON_BOOT=true
# Trust X-Forwarded-* headers from the reverse proxy in front of the app. Turn off if you expose
# the app directly with no proxy in front of it.
TRUST_PROXY=true
DATABASE_POOL_SIZE=10
