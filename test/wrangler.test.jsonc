{
  "name": "samla-test",
  "main": "./worker.ts",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "APP_URL": "http://localhost:3000",
    "APP_ENV": "test",
    "EMAIL_FROM": "samla <no-reply@samla.test>",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "TURNSTILE_SECRET_KEY": "1x0000000000000000000000000000000AA",
    "BETTER_AUTH_SECRET": "test-secret-test-secret-test-secret-1234",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "samla-db",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "../drizzle",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "POLL_ROOM", "class_name": "PollRoom" },
      { "name": "BOOKING_ROOM", "class_name": "BookingRoom" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PollRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["BookingRoom"] },
  ],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
  ],
}
