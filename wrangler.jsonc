{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whenweall",
  "main": "src/server.ts",
  "routes": [{ "pattern": "whenweall.com", "custom_domain": true }],
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  // `traces` is off unless asked for: automatic tracing is in early beta, so enabling
  // observability alone does not turn it on. Sampling at 1 (100%) is right at current volume —
  // the value of tracing early is catching the rare request, which sampling throws away. Spans
  // share the Workers Logs quota and are priced from 2026-10-01, so revisit the rate then.
  "observability": {
    "enabled": true,
    "traces": { "enabled": true, "head_sampling_rate": 1 },
  },
  "upload_source_maps": true,
  "vars": {
    "APP_URL": "https://whenweall.com",
    "APP_ENV": "production",
    "EMAIL_FROM": "whenweall <no-reply@whenweall.com>",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAEcpi42QywKz2sSm",
    // LIVE-mode prices (60 NOK/mo, 600 NOK/yr); test-mode ids live on the whenweall-test env.
    "STRIPE_PRICE_PREMIUM_MONTHLY": "price_1U8k2WDqZd85ftHmUfw4OH8O",
    "STRIPE_PRICE_PREMIUM_YEARLY": "price_1U8k2WDqZd85ftHmIqsuL2Uw",
  },
  // Jurisdiction-restricted to the EU, which is what `privacy_processors_body` promises users.
  // A D1 database's jurisdiction is fixed at creation, so this is a different database from the
  // original unrestricted `whenweall` (01c56eb2-...), migrated across by dump and restore. The old
  // one is deliberately left in place as the rollback; see docs/d1-eu-migration.md.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whenweall-eu",
      "database_id": "f3b57069-39e8-4ecd-9be6-f4db4bf00d1f",
      "migrations_dir": "drizzle",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "POLL_ROOM", "class_name": "PollRoom" },
      { "name": "BOOKING_ROOM", "class_name": "BookingRoom" },
      { "name": "STATS_ROOM", "class_name": "StatsRoom" },
      { "name": "RATE_LIMIT_ROOM", "class_name": "RateLimitRoom" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PollRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["BookingRoom"] },
    { "tag": "v3", "new_sqlite_classes": ["StatsRoom"] },
    { "tag": "v4", "new_sqlite_classes": ["RateLimitRoom"] },
  ],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
  ],
  // Staging twin at test.whenweall.com: same code, separate worker + D1 + secrets (Stripe TEST
  // keys live here). APP_ENV stays "production" on purpose - the URL is public, so seed/test
  // routes must stay disabled and HSTS on. Bindings are not inherited by wrangler envs, so the
  // block mirrors the top-level ones.
  "env": {
    "test": {
      "name": "whenweall-test",
      "routes": [{ "pattern": "test.whenweall.com", "custom_domain": true }],
      // Not inherited from the top level, like every other binding in this block.
      "observability": {
        "enabled": true,
        "traces": { "enabled": true, "head_sampling_rate": 1 },
      },
      "vars": {
        "APP_URL": "https://test.whenweall.com",
        "APP_ENV": "production",
        "EMAIL_FROM": "whenweall test <no-reply@whenweall.com>",
        "TURNSTILE_SITE_KEY": "0x4AAAAAAEcpi42QywKz2sSm",
        // TEST-mode Stripe prices (60 NOK/mo, 600 NOK/yr) - env vars are not inherited,
        // so the test worker declares its own pair.
        "STRIPE_PRICE_PREMIUM_MONTHLY": "price_1U8k6tDHpY37Lq0GWCCYcQnX",
        "STRIPE_PRICE_PREMIUM_YEARLY": "price_1U8k6tDHpY37Lq0G6P3Q3Qkz",
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "whenweall-test-eu",
          "database_id": "ac702181-c6f3-425c-ac85-24c4d60fa60f",
          "migrations_dir": "drizzle",
        },
      ],
      "durable_objects": {
        "bindings": [
          { "name": "POLL_ROOM", "class_name": "PollRoom" },
          { "name": "BOOKING_ROOM", "class_name": "BookingRoom" },
          { "name": "STATS_ROOM", "class_name": "StatsRoom" },
          { "name": "RATE_LIMIT_ROOM", "class_name": "RateLimitRoom" },
        ],
      },
      "send_email": [{ "name": "EMAIL" }],
      "ratelimits": [
        { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
      ],
    },
  },
}
