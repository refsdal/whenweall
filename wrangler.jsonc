{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "whenweall",
  "main": "src/server.ts",
  "compatibility_date": "2026-08-20",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  "upload_source_maps": true,
  "vars": {
    "APP_URL": "http://localhost:3000",
    "APP_ENV": "development",
    "EMAIL_FROM": "whenweall <no-reply@whenweall.com>",
    "TURNSTILE_SITE_KEY": "1x00000000000000000000AA",
    "STRIPE_PRICE_PREMIUM_MONTHLY": "price_premium_monthly_dev",
    "STRIPE_PRICE_PREMIUM_YEARLY": "price_premium_yearly_dev",
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "whenweall-db",
      // Placeholder UUID so `wrangler dev` works locally without a real D1 database. Replace
      // with the id printed by `wrangler d1 create whenweall-db` before deploying.
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "drizzle",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "POLL_ROOM", "class_name": "PollRoom" },
      { "name": "BOOKING_ROOM", "class_name": "BookingRoom" },
    ],
  },
  "migrations": [
    { "tag": "v1", "new_sqlite_classes": ["PollRoom"] },
    { "tag": "v2", "new_sqlite_classes": ["BookingRoom"] },
  ],
  "send_email": [{ "name": "EMAIL" }],
  "ratelimits": [
    { "name": "RATE_LIMITER", "namespace_id": "1001", "simple": { "limit": 20, "period": 60 } },
  ],
}
