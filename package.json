{
  "name": "whenweall",
  "private": true,
  "type": "module",
  "imports": {
    "#/*": "./src/*"
  },
  "scripts": {
    "postinstall": "paraglide-js compile --project ./project.inlang --outdir ./src/paraglide",
    "dev": "vite dev --port 3000",
    "build": "vite build",
    "preview": "bun run build && vite preview",
    "deploy": "bun run build && wrangler deploy",
    "deploy:test": "CLOUDFLARE_ENV=test bun run build && wrangler deploy",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:unit": "vitest run --project unit",
    "test:workers": "vitest run --project workers",
    "test:e2e": "playwright test",
    "screenshots": "SCREENSHOTS=1 playwright test --grep @screenshots",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply whenweall --local",
    "db:migrate:remote": "wrangler d1 migrations apply whenweall --remote",
    "db:migrate:remote:test": "wrangler d1 migrations apply whenweall-test --remote --env test",
    "auth:generate": "auth generate --config src/server/auth/auth.cli.ts --output src/server/db/auth-schema.ts -y",
    "cf-typegen": "wrangler types",
    "generate-routes": "tsr generate"
  },
  "dependencies": {
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@better-auth/passkey": "^1.7.1",
    "@date-fns/tz": "^1.5.0",
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@inlang/paraglide-js": "^2.24.1",
    "@marsidev/react-turnstile": "^1.6.0",
    "@react-email/components": "^1.0.12",
    "@react-email/render": "^2.1.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-start": "^1.168.48",
    "better-auth": "^1.7.1",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "nanoid": "^6.0.1",
    "radix-ui": "^1.6.7",
    "react": "^19.2.8",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.2.8",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.53.1",
    "@cloudflare/vitest-plugin": "^1.0.0",
    "@cloudflare/workers-types": "^5.20260820.1",
    "@eslint/js": "^10.0.1",
    "@msw/cloudflare": "^0.0.1",
    "@playwright/test": "^1.62.1",
    "@tanstack/devtools-vite": "^0.8.5",
    "@tanstack/react-devtools": "^0.10.12",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@tanstack/router-cli": "^1.167.32",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.5",
    "@types/bun": "^1.4.0",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.1.0",
    "auth": "^1.7.1",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "jsdom": "^30.0.1",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "tw-animate-css": "^1.4.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2",
    "vitest": "^4.1.11",
    "wrangler": "^4.125.0"
  }
}
